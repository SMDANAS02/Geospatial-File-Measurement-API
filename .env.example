# Application Settings
PROJECT_NAME="Geospatial File Measurement API"
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1

# Database Configuration
# SQLite local file path (by default relative to current working directory)
DATABASE_URL=sqlite:///./geospatial.db

# CORS Configuration
# Comma-separated list or JSON list of allowed origins for local frontend (e.g. React / Vite)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# File Upload Limits (in bytes)
MAX_UPLOAD_SIZE_BYTES=52428800
MAX_UNCOMPRESSED_SIZE_BYTES=157286400
